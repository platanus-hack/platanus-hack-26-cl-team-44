# URL pública de Myo: la TV pública (jueces) con el agente demo, /equipo/ con contraseña, y /wa y /agente con token para el escenario.
# El dominio sale de TOKI_DOMINIO (por ejemplo 179-66-157-161.sslip.io). Caddy saca el certificado HTTPS solo.
# Solo HTTP/1.1 y HTTP/2: con HTTP/3 (QUIC por UDP) el navegador se colgaba si el UDP 443 no pasaba.
{
	servers {
		protocols h1 h2
	}
}

{$TOKI_DOMINIO} {
	encode gzip

	# Agente: /agente/api/... → /api/...  (flush_interval -1 para que el SSE llegue al instante)
	# · Con el token del escenario (X-Myo-Token = TOKI_TOKEN): el agente con la memoria real, 127.0.0.1:8790.
	#   Lo usa la TV del escenario (deploy/escena.sh). El agente vuelve a revisar el token.
	# · Sin ese token (la TV pública): el agente demo con memoria ficticia, 127.0.0.1:8792. Caddy le agrega
	#   su token (TOKI_TOKEN_DEMO), así el navegador nunca lo ve. Esta rama nunca llega al 8790.
	handle_path /agente/* {
		@escenario header X-Myo-Token {$TOKI_TOKEN}
		handle @escenario {
			reverse_proxy 127.0.0.1:8790 {
				flush_interval -1
			}
		}
		handle {
			reverse_proxy 127.0.0.1:8792 {
				header_up X-Myo-Token {$TOKI_TOKEN_DEMO}
				flush_interval -1
			}
		}
	}

	# Puente de WhatsApp para la TV del escenario (127.0.0.1:8766): /wa/api/... → 127.0.0.1:8788/api/...
	# Solo /api/*; el puente exige el header X-Myo-Token. /webhook/wapi no se publica: wapi llama a 127.0.0.1 directo.
	handle_path /wa/* {
		handle /api/* {
			reverse_proxy 127.0.0.1:8788 {
				flush_interval -1
			}
		}
		handle {
			respond 404
		}
	}

	# Equipo: la misma TV con WhatsApp real y la memoria de la usuaria. Usuario y contraseña (TOKI_EQUIPO_HASH)
	# y Caddy agrega el token por dentro (TOKI_TOKEN), así el navegador nunca lo ve. Variables en /opt/toki/caddy.env.
	redir /equipo /equipo/ 302
	handle_path /equipo/* {
		basicauth {
			equipo {$TOKI_EQUIPO_HASH}
		}
		handle_path /agente/* {
			reverse_proxy 127.0.0.1:8790 {
				header_up X-Myo-Token {$TOKI_TOKEN}
				flush_interval -1
			}
		}
		handle_path /wa/* {
			handle /api/* {
				reverse_proxy 127.0.0.1:8788 {
					header_up X-Myo-Token {$TOKI_TOKEN}
					flush_interval -1
				}
			}
			handle {
				respond 404
			}
		}
		redir / /equipo/woki-os.html 302
		# TV v2 del equipo (apps/tv): /equipo/v2/ usa el mismo /equipo/wa y /equipo/agente con el token de Caddy
		redir /v2 /equipo/v2/ 302
		handle_path /v2/* {
			root * /opt/toki/repo/apps/tv/dist
			file_server
		}
		handle {
			root * /opt/toki/repo/software/toki-os
			file_server
		}
	}

	# TV v2 pública (apps/tv, React): convive con la TV actual hasta probar la paridad (apps/tv/PARIDAD.md).
	# Rutas relativas (Vite base './'): la misma build sirve aquí y en /equipo/v2/.
	redir /v2 /v2/ 302
	handle_path /v2/* {
		root * /opt/toki/repo/apps/tv/dist
		file_server
	}

	# La raíz abre la TV pública (jueces): WhatsApp simulado, sin datos de la usuaria
	redir / /woki-os.html?{query} 302

	handle {
		root * /opt/toki/repo/software/toki-os
		file_server
	}

	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		# La TV usa la cámara y el micrófono del navegador
		Permissions-Policy "camera=(self), microphone=(self)"
	}
}
