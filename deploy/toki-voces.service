[Unit]
Description=Myo · huellas de voz (software/voces/server.py, 127.0.0.1:8791)
After=network-online.target

[Service]
User=toki
WorkingDirectory=/opt/toki/repo
Environment=PYTHONUNBUFFERED=1
Environment=NUMBA_CACHE_DIR=/tmp/toki-numba
ExecStart=/opt/toki/voces-venv/bin/python software/voces/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
